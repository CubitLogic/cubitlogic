# Cubit Logic environment template
NODE_ENV=production
PORT=3000

# App/OAuth
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
JWT_SECRET=replace-with-a-long-random-secret
OWNER_EMAIL=owner@example.com
OWNER_OPEN_ID=

# Database
DATABASE_URL=mysql://user:password@host:3306/database

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI Tutor (Gemini free tier)
# Create the key in Google AI Studio, then add it only to your host's secrets.
# Never commit this value or paste it into the site source.
GEMINI_API_KEY=
# Optional override for another OpenAI-compatible provider. Gemini defaults to
# https://generativelanguage.googleapis.com/v1beta/openai and gemini-3.1-flash-lite.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# CubitAI controls. Set CUBIT_AI_ENABLED=false to stop all paid AI calls
# immediately without changing the website. The daily cap applies to one app
# process and resets at UTC midnight; lower it during an early trial.
CUBIT_AI_ENABLED=true
CUBIT_AI_DAILY_REQUEST_LIMIT=25
CUBIT_AI_MAX_OUTPUT_TOKENS=600

# Microsoft Foundry project (optional). When all three values are set, CubitAI
# calls the project Responses API at <project endpoint>/openai/v1/responses.
# Find the endpoint on the Foundry project Overview page. This keeps the key
# server-side and is reversible by setting CUBIT_AI_ENABLED=false or removing
# these three values.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=

# Your existing Foundry *agent* (preferred when you want the QubitAI agent's
# own instructions and configuration to run on CubitLogic.com). Copy its
# Responses endpoint from Foundry > agent > Details > Responses protocol.
# The agent endpoint requires Microsoft Entra authentication; do not use a
# personal browser token. Create or reuse a server app identity with the
# Foundry Agent Consumer role, then store its values only in GoDaddy.
FOUNDRY_AGENT_RESPONSES_ENDPOINT=
FOUNDRY_TENANT_ID=
FOUNDRY_CLIENT_ID=
FOUNDRY_CLIENT_SECRET=
# Temporary troubleshooting only. Prefer the client credentials above because
# access tokens expire.
FOUNDRY_AGENT_ACCESS_TOKEN=

# Azure Foundry / Azure OpenAI alternative. Use the Azure OpenAI-compatible
# base endpoint (for example, https://YOUR-RESOURCE.openai.azure.com/openai/v1)
# and the deployment name. The server uses Azure's api-key header automatically.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Manus/Forge storage only needed if you still use /manus-storage uploads
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
